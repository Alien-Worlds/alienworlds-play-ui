  "scripts": {
    "start:local": "yarn && dotenv -e ./.env react-scripts start",
    "start:local:node17": "dotenv -e ./.env NODE_OPTIONS=--openssl-legacy-provider react-scripts start",
    "start:development": "dotenv -e ./src/config/.env.development react-scripts start",
    "start:production": "dotenv -e ./src/config/.env.production react-scripts start",
    "build": "if test \"$CF_PAGES_BRANCH\" = \"master\" ; then npm run build:production ; else react-scripts build ; fi",
    "build:local": "dotenv -e ./.env react-scripts build",
    "build:development": "react-scripts build",
    "build:production": "dotenv -e ./src/config/.env.production react-scripts build",
    "build:production:node17": "NODE_OPTIONS=--openssl-legacy-provider dotenv -e ./src/config/.env.production react-scripts build",
    "test": "react-scripts test --watchAll=false --passWithNoTests",
    "prepare": "husky install",
    "prebuild": "rm -rf ./dist"
  },
  "engines": {
    "node": ">= 16.16.0"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
